<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="CamStream.msi" LogicalName="CamStream.Msi" Condition="Exists('CamStream.msi')" />
    <EmbeddedResource Include="WindowsAppRuntimeInstall-x64.exe" LogicalName="CamStream.Runtime" Condition="Exists('WindowsAppRuntimeInstall-x64.exe')" />
  </ItemGroup>
</Project>

